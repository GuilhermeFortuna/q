#!/usr/bin/env bash
# Workspace development launcher for the Q platform.
#
# Docker Compose provides Postgres/Redis; systemd user units supervise Q backend
# and MT5 services. q_terminal and Research UI run in background sessions.
#
# Usage (from workspace root or any directory):
#   ./dev [live|research|all]   # default: all
#   ./dev live                  # full live execution profile + q_terminal
#   ./dev research [opts]       # research backend + UI (--host default | --container)
#   ./dev down [target]         # stop: live | research | all (default: all)
#   ./dev status                # concise stack overview of both stacks
#   ./dev logs <service>        # follow logs with aliases (e.g. api, research:api)
#   ./dev restart <service>     # restart service by alias
#   ./dev up terminal|full|exec # legacy profile start
#   ./dev shell               # interactive dev> prompt
#   ./dev --help

set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BACKEND_DIR="$ROOT/q_backend"
TERMINAL_DIR="$ROOT/q_terminal"

# Live stack settings
COMPOSE_PROJECT="${Q_DEV_COMPOSE_PROJECT:-q-dev}"
COMPOSE=(docker compose --project-directory "$BACKEND_DIR" -f "$BACKEND_DIR/docker-compose.yml" -p "$COMPOSE_PROJECT")

PG_PORT="${Q_DEV_PG_PORT:-5434}"
REDIS_PORT="${Q_DEV_REDIS_PORT:-6380}"
API_PORT="${Q_DEV_API_PORT:-8000}"
export Q_COMPOSE_PG_PORT="$PG_PORT" Q_COMPOSE_REDIS_PORT="$REDIS_PORT"
export Q_COMPOSE_DATA_DIR="$BACKEND_DIR/data"
API_HEALTH_URL="${Q_DEV_HEALTH_URL:-http://127.0.0.1:${API_PORT}/api/v1/system/health}"
EXEC_HEALTH_URL="${Q_DEV_EXEC_HEALTH_URL:-http://127.0.0.1:${API_PORT}/api/v1/execution/health}"
GATEWAY_URL="${Q_DEV_GATEWAY_URL:-http://127.0.0.1:18812}"
GATEWAY_HEALTH_URL="${Q_DEV_GATEWAY_HEALTH_URL:-${GATEWAY_URL}/v1/health}"
GATEWAY_ENV_FILE="${HOME}/.config/mt5-gateway/mt5-gateway.env"
EDGE_HEALTH_URL="${Q_DEV_EDGE_HEALTH_URL:-http://127.0.0.1:18813/v1/health}"

WAIT_ATTEMPTS="${Q_DEV_WAIT_ATTEMPTS:-90}"
WAIT_INTERVAL="${Q_DEV_WAIT_INTERVAL:-0.5}"
STATE_DIR="${Q_DEV_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/q-dev}"

dev_follow() {
  if [[ "${Q_DEV_SHELL_ACTIVE:-0}" == "1" ]]; then
    "$@" || {
      local rc=$?
      if [[ $rc -eq 130 || $rc -eq 143 ]]; then
        return 0
      fi
      return "$rc"
    }
  else
    exec "$@"
  fi
}

# Load Research helpers
# shellcheck source=tools/dev/research.sh
source "$ROOT/tools/dev/research.sh"

BACKEND_ENV_CHANGED=0

die() {
  echo "error: $*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "'$1' is required but was not found on PATH"
}

usage() {
  cat <<'EOF'
Usage: ./dev [command] [args]

Commands:
  ./dev, ./dev all        Start both stacks and both desktop UIs (default)
  ./dev live              Start the full live execution profile and Qt terminal
  ./dev research [opts]   Start Research backend and UI (--host default | --container)
                          [--rebuild requires container mode]
  ./dev down [target]     Stop stacks: live | research | all (default: all)
  ./dev status            Show concise overview of both stacks, APIs, workers, UIs
  ./dev logs <service>    Follow service logs (e.g. api, outbox, research:api, ...)
  ./dev restart <service> Restart service by alias (e.g. api, research:worker, ...)
  ./dev up <profile>      Legacy start: terminal | execution | full
  ./dev shell             Interactive dev> prompt (exit does not stop stacks)
  ./dev --help            Show this help

Modes for research:
  --host                  (default) Postgres & Redis in Docker; API and worker run
                          from q_backend/.venv on host with direct GPU access.
  --container             Postgres, Redis, API, worker run in Docker on q-backend:dev.
  --rebuild               Rebuild backend image (container mode only).

Persistence and Lifecycle:
  Commands return after starting desktop UIs.
  Closing a UI window or pressing Ctrl+C does NOT tear down either backend.
  Backends stay running until explicitly stopped via: ./dev down [live|research|all]

Service aliases:
  Live:     postgres, redis, migrate, api, outbox, publisher, execution, live, terminal
  Shared:   mt5, gateway, edge
  Research: research:postgres, research:redis, research:migrate, research:api,
            research:worker, research:relay, research:ui
  (Unqualified aliases default to live stack; use research:<svc> for research stack.)
EOF
}

# --- service metadata ---

service_kind() {
  case "${1,,}" in
    postgres|redis) echo "docker" ;;
    migrate) echo "migrate" ;;
    api|outbox|publisher|market|execution) echo "systemd-backend" ;;
    mt5|terminal-mt5|gateway|edge) echo "systemd-mt5" ;;
    live) echo "capability" ;;
    terminal) echo "terminal" ;;
    research|worker) echo "research" ;;
    *) die "unknown service alias: $1 (try: api, outbox, publisher, postgres, redis, execution, live, mt5, gateway, edge, terminal)" ;;
  esac
}

compose_service() {
  case "${1,,}" in
    postgres) echo "postgres" ;;
    redis) echo "redis" ;;
    *) die "no compose service for alias: $1" ;;
  esac
}

backend_unit() {
  case "${1,,}" in
    api) echo "q-api.service" ;;
    outbox) echo "q-outbox-relay.service" ;;
    publisher|market) echo "q-market-publisher.service" ;;
    execution) echo "q-execution-worker.service" ;;
    *) die "no backend unit for alias: $1" ;;
  esac
}

mt5_unit() {
  case "${1,,}" in
    mt5|terminal-mt5) echo "mt5-terminal.service" ;;
    gateway) echo "mt5-gateway.service" ;;
    edge) echo "mt5-edge.service" ;;
    *) die "no MT5 unit for alias: $1" ;;
  esac
}

systemd_unit() {
  local kind
  kind="$(service_kind "$1")"
  case "$kind" in
    systemd-backend) backend_unit "$1" ;;
    systemd-mt5) mt5_unit "$1" ;;
    *) die "no systemd unit for alias: $1" ;;
  esac
}

# --- Docker helpers ---

ensure_docker() {
  need docker
  docker compose version >/dev/null 2>&1 || die "Docker Compose is required (verify: docker compose version)"
  docker info >/dev/null 2>&1 || die "Docker daemon is not reachable (verify: docker info)"
}

docker_service_running() {
  local service="$1"
  "${COMPOSE[@]}" ps --status running --services 2>/dev/null | grep -qx "$service"
}

check_port() {
  local port="$1"
  if [[ -n "${Q_TEST_STATE:-}" ]]; then
    if [[ -f "$Q_TEST_STATE/ports/$port" ]]; then
      return 0
    fi
    if [[ "$port" == "$PG_PORT" || "$port" == "$REDIS_PORT" ]]; then
      if [[ -f "$Q_TEST_STATE/compose_state" ]] && grep -q "up" "$Q_TEST_STATE/compose_state" 2>/dev/null; then
        return 0
      fi
    fi
    return 1
  fi
  (echo > /dev/tcp/127.0.0.1/"$port") >/dev/null 2>&1
}

port_holder_hint() {
  local port="$1" service="$2"
  local holder project name
  holder="$(docker ps --filter "publish=${port}" \
    --format '{{.Label "com.docker.compose.project"}} {{.Names}}' 2>/dev/null | head -1 || true)"
  [[ -n "$holder" ]] || return 0
  project="${holder%% *}"
  name="${holder#* }"
  if [[ -n "$project" && "$project" != "$COMPOSE_PROJECT" ]]; then
    echo "hint: $name (compose project: $project) is still running — stop it with:" >&2
    echo "      docker compose -p $project -f $BACKEND_DIR/docker-compose.yml stop $service" >&2
    return 0
  fi
  echo "hint: stop the conflicting service, or run: docker compose -p $COMPOSE_PROJECT -f $BACKEND_DIR/docker-compose.yml stop $service" >&2
}

guard_port_conflicts() {
  local service port
  for service in postgres redis; do
    port="$PG_PORT"
    [[ "$service" == "redis" ]] && port="$REDIS_PORT"
    if check_port "$port" && ! docker_service_running "$service"; then
      echo "error: port $port is in use by a non-Q-dev container or process." >&2
      port_holder_hint "$port" "$service"
      exit 1
    fi
  done
  if check_port "$API_PORT"; then
    if ! ready_api || ! unit_active "$(backend_unit api)"; then
      echo "error: port $API_PORT is in use by another process or container." >&2
      echo "hint: check 'lsof -i :$API_PORT' or stop the conflicting service." >&2
      exit 1
    fi
  fi
}

start_docker_infra() {
  local attempt host_ports_ready
  mkdir -p \
    "$BACKEND_DIR/data/lake" \
    "$BACKEND_DIR/data/market" \
    "$BACKEND_DIR/data/tick_cache"
  echo "==> Starting Postgres and Redis (Docker Compose project: $COMPOSE_PROJECT)..."
  "${COMPOSE[@]}" up -d --wait postgres redis

  host_ports_ready=0
  for ((attempt = 0; attempt < 10; attempt++)); do
    if check_port "$PG_PORT" && check_port "$REDIS_PORT"; then
      host_ports_ready=1
      break
    fi
    sleep 0.5
  done
  if [[ "$host_ports_ready" -eq 0 ]]; then
    echo "==> Host ports are not published; recreating $COMPOSE_PROJECT infrastructure..."
    "${COMPOSE[@]}" up -d --force-recreate --wait postgres redis
  fi
}

stop_docker_infra() {
  echo "==> Removing Q-dev containers and network (database volumes are preserved)..."
  "${COMPOSE[@]}" down --remove-orphans 2>/dev/null || true
}

# --- systemd helpers ---

ensure_systemd_user() {
  need systemctl
  if ! systemctl --user status >/dev/null 2>&1; then
    die "systemd user session is not available (is \$XDG_RUNTIME_DIR set?)"
  fi
}

unit_installed() {
  systemctl --user cat "$1" >/dev/null 2>&1
}

unit_active() {
  systemctl --user is-active --quiet "$1" 2>/dev/null
}

unit_state() {
  systemctl --user show -p ActiveState,SubState --value "$1" 2>/dev/null | tr '\n' '/' | sed 's|/$||'
}

render_and_install_unit() {
  local template="$1"
  local dst="$2"
  local tmp
  tmp="$(mktemp)"
  sed "s|@Q_BACKEND_DIR@|$BACKEND_DIR|g" "$template" >"$tmp"
  if [[ -f "$dst" ]] && cmp -s "$tmp" "$dst"; then
    rm -f "$tmp"
    return 1
  fi
  mv "$tmp" "$dst"
  return 0
}

ensure_backend_env_file() {
  local config_dir="${HOME}/.config/q"
  local env_file="$config_dir/backend.env"
  mkdir -p "$config_dir"
  local before=""
  [[ -f "$env_file" ]] && before="$(cksum <"$env_file")"

  if [[ ! -f "$env_file" ]]; then
    cp "$BACKEND_DIR/deploy/systemd/backend.env.example" "$env_file"
  fi

  local -a keys=(
    "Q_DATABASE_URL=postgresql+psycopg://q:q@127.0.0.1:${PG_PORT}/q"
    "Q_REDIS_URL=redis://127.0.0.1:${REDIS_PORT}/0"
    "Q_DATA_LAKE_ROOT=$BACKEND_DIR/data/lake"
    "Q_MARKET_DATA_ROOT=$BACKEND_DIR/data/market"
    "Q_TICK_CACHE_DIR=$BACKEND_DIR/data/tick_cache"
    "Q_RUNTIME_CONFIG_PATH=$BACKEND_DIR/data/runtime_config.json"
    "Q_MT5_GATEWAY_URL=$GATEWAY_URL"
  )
  local gateway_token=""
  if [[ -f "$GATEWAY_ENV_FILE" ]]; then
    gateway_token="$(sed -n 's/^MT5_GATEWAY_TOKEN=//p' "$GATEWAY_ENV_FILE" | tail -n1)"
  fi
  if [[ -n "$gateway_token" ]]; then
    keys+=("Q_MT5_GATEWAY_TOKEN=$gateway_token")
  fi
  local line key val
  for line in "${keys[@]}"; do
    key="${line%%=*}"
    val="${line#*=}"
    if grep -q "^${key}=" "$env_file"; then
      KEY="$key" VAL="$val" awk 'BEGIN { k = ENVIRON["KEY"] "=" }
        index($0, k) == 1 { print k ENVIRON["VAL"]; next } { print }' \
        "$env_file" >"$env_file.tmp" && mv "$env_file.tmp" "$env_file"
    else
      printf '%s=%s\n' "$key" "$val" >>"$env_file"
    fi
  done

  if [[ "$(cksum <"$env_file")" != "$before" ]]; then
    BACKEND_ENV_CHANGED=1
  fi
}

install_dev_units() {
  local dest="${HOME}/.config/systemd/user"
  local template_dir="$BACKEND_DIR/deploy/systemd/dev"
  local changed=0

  ensure_systemd_user
  ensure_backend_env_file

  echo "==> Installing dev systemd user units..."
  (cd "$BACKEND_DIR" && uv sync --frozen --no-dev)

  mkdir -p "$dest"
  for template in "$template_dir"/*.service.in; do
    local unit_name
    unit_name="$(basename "$template" .in)"
    if render_and_install_unit "$template" "$dest/$unit_name"; then
      changed=1
    fi
  done

  if [[ "$changed" -eq 1 ]]; then
    systemctl --user daemon-reload
  fi
}

seed_env_file() {
  local example="$1"
  local dest="$2"

  if [[ -f "$dest" ]]; then
    return 0
  fi

  mkdir -p "$(dirname "$dest")"
  sed \
    -e "s|/home/CHANGE_ME/q/q_backend|${BACKEND_DIR}|g" \
    -e "s|/home/CHANGE_ME|${HOME}|g" \
    "$example" > "$dest"
  echo "created $dest from $(basename "$example")"
}

ensure_mt5_units() {
  local unit_dir="${HOME}/.config/systemd/user"
  local gateway_env="$GATEWAY_ENV_FILE"
  local edge_env="${HOME}/.config/mt5-edge/mt5-edge.env"
  local systemd_src="$BACKEND_DIR/gateway/systemd"
  local changed=0

  mkdir -p "$unit_dir"

  for unit in mt5-terminal.service mt5-gateway.service mt5-edge.service; do
    local src="$systemd_src/$unit"
    local dst="$unit_dir/$unit"
    [[ -f "$src" ]] || die "missing $src"
    if [[ ! -f "$dst" ]] || ! cmp -s "$src" "$dst"; then
      cp "$src" "$dst"
      changed=1
    fi
  done

  seed_env_file "$systemd_src/mt5-gateway.env.example" "$gateway_env"
  seed_env_file "$systemd_src/mt5-edge.env.example" "$edge_env"

  if [[ "$changed" -eq 1 ]]; then
    systemctl --user daemon-reload
  fi
}

# --- health helpers ---

exec_health_json() {
  curl -fsS "$EXEC_HEALTH_URL" 2>/dev/null || echo '{}'
}

exec_health_field() {
  local py="$1"
  need python3
  exec_health_json | python3 -c "import json,sys
data=json.load(sys.stdin)
${py}" 2>/dev/null || true
}

edge_http_reachable() {
  curl -fsS "$EDGE_HEALTH_URL" >/dev/null 2>&1
}

edge_mt5_connected() {
  local connected
  connected="$(curl -fsS "$EDGE_HEALTH_URL" 2>/dev/null | sed -n 's/.*"mt5_connected"[[:space:]]*:[[:space:]]*\([^,}]*\).*/\1/p' | head -n1)"
  [[ "$connected" == "true" ]]
}

execution_worker_process_ready() {
  unit_active "$(backend_unit execution)"
}

execution_worker_heartbeat_ready() {
  need python3
  exec_health_json | python3 -c "import json,sys
try:
    d = json.load(sys.stdin)
    sys.exit(0 if d.get('worker_status') in ('healthy', 'stale') else 1)
except Exception:
    sys.exit(1)" 2>/dev/null
}

execution_live_available() {
  need python3
  exec_health_json | python3 -c "import json,sys
try:
    d = json.load(sys.stdin)
    ok = (d.get('worker_status') == 'healthy' and
          d.get('edge', {}).get('reachable') is True and
          d.get('edge', {}).get('mt5_connected') is True)
    sys.exit(0 if ok else 1)
except Exception:
    sys.exit(1)" 2>/dev/null
}

# --- readiness checks ---

ready_postgres() {
  check_port "$PG_PORT" || return 1
  if [[ -n "${Q_TEST_STATE:-}" ]]; then return 0; fi
  if command -v pg_isready >/dev/null 2>&1; then
    pg_isready -h 127.0.0.1 -p "$PG_PORT" -U q -d q >/dev/null 2>&1
  elif docker_service_running postgres; then
    "${COMPOSE[@]}" exec -T postgres pg_isready -U q -d q >/dev/null 2>&1
  else
    return 1
  fi
}

ready_redis() {
  check_port "$REDIS_PORT" || return 1
  if [[ -n "${Q_TEST_STATE:-}" ]]; then return 0; fi
  if command -v redis-cli >/dev/null 2>&1; then
    [[ "$(redis-cli -p "$REDIS_PORT" ping 2>/dev/null)" == "PONG" ]]
  elif docker_service_running redis; then
    [[ "$("${COMPOSE[@]}" exec -T redis redis-cli ping 2>/dev/null)" == "PONG" ]]
  else
    return 1
  fi
}

ready_api() {
  curl -fsS "$API_HEALTH_URL" >/dev/null 2>&1
}

ready_outbox() {
  unit_active "$(backend_unit outbox)"
}

ready_publisher() {
  unit_active "$(backend_unit publisher)"
}

ready_gateway() {
  curl -fsS "$GATEWAY_HEALTH_URL" >/dev/null 2>&1
}

ready_edge() {
  edge_http_reachable
}

ready_mt5_terminal() {
  unit_active "$(mt5_unit mt5)"
}

migrate_done() {
  [[ -f "$STATE_DIR/migrate.stamp" ]]
}

# --- terminal UI process validation ---

validate_terminal_pid() {
  local pid="$1"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  local cmd=""
  if [[ -f "/proc/$pid/cmdline" ]]; then
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
  elif command -v ps >/dev/null 2>&1; then
    cmd="$(ps -p "$pid" -o args= 2>/dev/null || true)"
  fi
  [[ -z "$cmd" ]] && return 0
  [[ "$cmd" == *"q_terminal"* || "$cmd" == *"terminal"* || "$cmd" == *"make"* ]]
}

is_terminal_running() {
  local pidfile="$STATE_DIR/q_terminal.pid"
  [[ -f "$pidfile" ]] || return 1
  local pid
  pid="$(cat "$pidfile" 2>/dev/null || true)"
  [[ -n "$pid" ]] || return 1
  if kill -0 "$pid" 2>/dev/null && validate_terminal_pid "$pid"; then
    return 0
  fi
  rm -f "$pidfile"
  return 1
}

stop_terminal() {
  local pidfile="$STATE_DIR/q_terminal.pid"
  [[ -f "$pidfile" ]] || return 0
  local pid
  pid="$(cat "$pidfile" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    if validate_terminal_pid "$pid"; then
      kill "$pid" 2>/dev/null || true
      echo "stopped q_terminal"
    fi
  fi
  rm -f "$pidfile"
}

readiness_summary() {
  local alias="$1"
  case "$alias" in
    postgres)
      if ready_postgres; then echo "ready"; else echo "not ready"; fi
      ;;
    redis)
      if ready_redis; then echo "PONG"; else echo "not ready"; fi
      ;;
    migrate)
      if migrate_done; then echo "done"; else echo "pending"; fi
      ;;
    api)
      if ready_api; then echo "healthy"; else echo "not ready"; fi
      ;;
    outbox)
      if ready_outbox; then echo "active"; else echo "not ready"; fi
      ;;
    gateway)
      if ready_gateway; then
        local connected
        connected="$(curl -fsS "$GATEWAY_HEALTH_URL" 2>/dev/null | sed -n 's/.*"mt5_connected"[[:space:]]*:[[:space:]]*\([^,}]*\).*/\1/p' | head -n1)"
        echo "http ok (mt5_connected=${connected:-unknown})"
      else
        echo "unavailable"
      fi
      ;;
    edge)
      if ready_edge; then
        if edge_mt5_connected; then
          echo "reachable (mt5_connected)"
        else
          echo "reachable (mt5 not connected)"
        fi
      else
        echo "unavailable"
      fi
      ;;
    execution)
      if ! execution_worker_process_ready; then
        echo "offline"
      elif execution_live_available; then
        echo "$(exec_health_field "print(data.get('worker_status', 'offline'), end='')")"
      elif execution_worker_heartbeat_ready; then
        echo "$(exec_health_field "print(data.get('worker_status', 'offline'), end='')") (degraded)"
      else
        echo "starting"
      fi
      ;;
    live)
      if execution_live_available; then
        echo "available"
      else
        echo "unavailable"
      fi
      ;;
    publisher)
      if ! ready_publisher; then
        echo "not ready"
      elif ready_gateway; then
        echo "active (gateway reachable)"
      else
        echo "active (waiting for gateway)"
      fi
      ;;
    terminal)
      if is_terminal_running; then echo "running"; else echo "stopped"; fi
      ;;
    research)
      echo "see research stack"
      ;;
    mt5)
      if unit_active "$(mt5_unit mt5)"; then echo "active"; else echo "inactive"; fi
      ;;
    *)
      echo "-"
      ;;
  esac
}

wait_for() {
  local label="$1"
  local hint="$2"
  local check_fn="$3"
  local i start elapsed

  if "$check_fn"; then
    echo "$label: already ready"
    return 0
  fi

  echo "waiting for $label..."
  start=$SECONDS
  for ((i = 1; i <= WAIT_ATTEMPTS; i++)); do
    sleep "$WAIT_INTERVAL"
    if "$check_fn"; then
      elapsed=$((SECONDS - start))
      echo "$label: ready (${elapsed}s)"
      return 0
    fi
  done

  elapsed=$((SECONDS - start))
  echo "error: $label did not become ready within ${elapsed}s" >&2
  [[ -n "$hint" ]] && echo "hint: $hint" >&2
  return 1
}

run_migrations() {
  echo "==> Running database migrations..."
  ensure_backend_env_file
  # shellcheck disable=SC1091
  set -a && source "${HOME}/.config/q/backend.env" && set +a
  (cd "$BACKEND_DIR" && "$BACKEND_DIR/.venv/bin/alembic" upgrade head)
  mkdir -p "$STATE_DIR"
  date -Iseconds >"$STATE_DIR/migrate.stamp"
}

start_systemd_backend() {
  install_dev_units
  need curl

  if [[ "$BACKEND_ENV_CHANGED" -eq 1 ]]; then
    echo "==> backend.env changed; (re)starting API and outbox relay (systemd)..."
    systemctl --user restart "$(backend_unit api)" "$(backend_unit outbox)"
  elif unit_active "$(backend_unit api)" && unit_active "$(backend_unit outbox)" && ready_api; then
    echo "systemd backend: already running"
    return 0
  else
    echo "==> Starting API and outbox relay (systemd)..."
    systemctl --user start "$(backend_unit api)" "$(backend_unit outbox)"
  fi
  wait_for "api" "journalctl --user -u $(backend_unit api) -n 30 --no-pager" ready_api
  wait_for "outbox relay" "journalctl --user -u $(backend_unit outbox) -n 30 --no-pager" ready_outbox
}

start_terminal_backend() {
  echo "==> Starting terminal backend stack..."
  ensure_systemd_user
  guard_port_conflicts

  start_docker_infra

  wait_for "postgres" "${COMPOSE[*]} logs postgres" ready_postgres
  wait_for "redis" "${COMPOSE[*]} logs redis" ready_redis
  run_migrations
  start_systemd_backend
}

have_wine() {
  command -v wine >/dev/null 2>&1
}

start_backend_unit() {
  local alias="$1" label="$2" check_fn="$3"
  local unit
  unit="$(backend_unit "$alias")"
  if [[ "$BACKEND_ENV_CHANGED" -eq 1 ]]; then
    systemctl --user restart "$unit" || true
  elif "$check_fn"; then
    echo "$label: already running"
    return 0
  else
    systemctl --user start "$unit" || true
  fi
  wait_for "$label" "journalctl --user -u $unit -n 30 --no-pager" "$check_fn" || {
    echo "warning: $label unit did not become active" >&2
  }
}

start_market_stack() {
  echo "==> Starting live market data (MT5 terminal, gateway, publisher)..."

  if have_wine; then
    systemctl --user start "$(mt5_unit mt5)" || true
    wait_for "mt5 terminal" "journalctl --user -u $(mt5_unit mt5) -n 30 --no-pager" ready_mt5_terminal || {
      echo "warning: mt5 terminal did not become ready (broker login or Wine prefix may be needed)" >&2
    }

    systemctl --user start "$(mt5_unit gateway)" || true
    wait_for "mt5 gateway" "journalctl --user -u $(mt5_unit gateway) -n 30 --no-pager" ready_gateway || {
      echo "warning: mt5 gateway health check timed out (broker login may still be pending)" >&2
    }
  else
    echo "warning: wine is not installed — skipping MT5 terminal/gateway (no live market data)" >&2
    echo "hint: install wine and run q_backend/gateway/setup_wine.sh, then retry" >&2
  fi

  start_backend_unit publisher "market-data publisher" ready_publisher
}

start_execution_stack() {
  echo "==> Starting MT5 edge / execution worker..."

  if have_wine; then
    systemctl --user start "$(mt5_unit edge)" || true
    wait_for "mt5 edge" "journalctl --user -u $(mt5_unit edge) -n 30 --no-pager" ready_edge || {
      echo "warning: mt5 edge health check timed out (broker login may still be pending)" >&2
    }
  else
    echo "warning: wine is not installed — skipping MT5 edge" >&2
  fi

  start_backend_unit execution "execution worker (process)" execution_worker_process_ready
}

execution_up_message() {
  if execution_live_available; then
    echo "==> Execution stack is up."
  else
    echo "==> Execution stack is up (degraded — live execution unavailable)."
    printf "    execution: %s | edge: %s | live: %s\n" \
      "$(readiness_summary execution)" \
      "$(readiness_summary edge)" \
      "$(readiness_summary live)"
  fi
}

start_profile() {
  local profile="$1"
  ensure_docker
  ensure_systemd_user
  if have_wine; then
    ensure_mt5_units
    local -a mt5_early=("$(mt5_unit mt5)" "$(mt5_unit gateway)")
    if [[ "$profile" == "execution" || "$profile" == "full" ]]; then
      mt5_early+=("$(mt5_unit edge)")
    fi
    echo "==> Pre-starting MT5 Wine services in background..."
    systemctl --user start "${mt5_early[@]}" || true
  fi
  start_terminal_backend
  start_market_stack

  if [[ "$profile" == "execution" || "$profile" == "full" ]]; then
    start_execution_stack
  fi
}

launch_terminal() {
  : "${Q_TERMINAL_API_BASE:=http://127.0.0.1:${API_PORT}}"
  : "${Q_TERMINAL_SYMBOL:=PETR4}"
  : "${Q_TERMINAL_TIMEFRAME:=M1}"
  export Q_TERMINAL_API_BASE Q_TERMINAL_SYMBOL Q_TERMINAL_TIMEFRAME

  mkdir -p "$STATE_DIR"
  local pidfile="$STATE_DIR/q_terminal.pid"
  if [[ -f "$pidfile" ]]; then
    local pid
    pid="$(cat "$pidfile" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && validate_terminal_pid "$pid"; then
      echo "q_terminal: already running (PID $pid)"
      return 0
    fi
    rm -f "$pidfile"
  fi

  echo "==> Launching q_terminal in background..."
  (
    exec make -C "$TERMINAL_DIR" run
  ) >"$STATE_DIR/terminal.log" 2>&1 &
  local pid=$!
  echo "$pid" >"$pidfile"
  echo "q_terminal started (PID $pid, log: $STATE_DIR/terminal.log)"
}

cmd_live() {
  start_profile full
  execution_up_message
  launch_terminal
}

cmd_research() {
  local mode="${Q_RESEARCH_MODE:-host}"
  local rebuild=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host)
        mode="host"
        shift
        ;;
      --container|--containerized)
        mode="container"
        shift
        ;;
      --rebuild)
        rebuild=1
        shift
        ;;
      --help|-h)
        usage
        exit 0
        ;;
      *)
        die "unknown argument: $1 (try ./dev --help)"
        ;;
    esac
  done

  if [[ "$rebuild" -eq 1 && "$mode" != "container" ]]; then
    die "--rebuild requires container mode (--container)"
  fi

  start_research "$mode" "$rebuild"
}

cmd_all() {
  echo "==> Starting Live and Research stacks..."
  local live_fail=0 research_fail=0

  if ! ( cmd_live ); then
    echo "error: failed to start Live stack" >&2
    live_fail=1
  fi

  local res_mode="${Q_RESEARCH_MODE:-host}"
  if ! ( start_research "$res_mode" 0 ); then
    echo "error: failed to start Research stack" >&2
    research_fail=1
  fi

  if [[ "$live_fail" -ne 0 || "$research_fail" -ne 0 ]]; then
    echo "==> Start failed. Current stack status:" >&2
    cmd_status >&2
    return 1
  fi
  echo "==> Both Live and Research stacks started."
}

cmd_up() {
  local profile="${1:-}"
  case "$profile" in
    terminal)
      start_profile terminal
      launch_terminal
      ;;
    execution)
      start_profile execution
      execution_up_message
      ;;
    full)
      start_profile full
      execution_up_message
      launch_terminal
      ;;
    *)
      die "usage: ./dev up terminal|execution|full"
      ;;
  esac
}

systemd_available() {
  command -v systemctl >/dev/null 2>&1 && systemctl --user status >/dev/null 2>&1
}

cmd_down_live() {
  local keep_shared_gateway="${1:-0}"
  stop_terminal
  if systemd_available; then
    systemctl --user stop \
      "$(backend_unit execution)" \
      "$(backend_unit publisher)" \
      "$(mt5_unit edge)" \
      "$(backend_unit outbox)" \
      "$(backend_unit api)" \
      2>/dev/null || true

    if [[ "$keep_shared_gateway" -eq 1 ]]; then
      echo "==> Keeping shared MT5 terminal and gateway running (in use by Research stack)"
    else
      systemctl --user stop \
        "$(mt5_unit gateway)" \
        "$(mt5_unit mt5)" \
        2>/dev/null || true
    fi
  fi
  if command -v docker >/dev/null 2>&1; then
    stop_docker_infra
  fi
  echo "==> Q live dev stack stopped."
}

cmd_down_research() {
  research_down
}

cmd_down() {
  local target="${1:-all}"
  case "$target" in
    live)
      local keep_gw=0
      if is_research_using_gateway; then
        keep_gw=1
      fi
      cmd_down_live "$keep_gw"
      ;;
    research)
      cmd_down_research
      ;;
    all)
      cmd_down_live 0
      cmd_down_research
      echo "==> All Q dev stacks stopped."
      ;;
    *)
      die "invalid down target: $target (expected live|research|all)"
      ;;
  esac
}

service_state() {
  local alias="$1"
  local kind unit

  kind="$(service_kind "$alias")"
  case "$kind" in
    docker)
      local svc
      svc="$(compose_service "$alias")"
      if docker_service_running "$svc"; then
        echo "running"
      elif check_port "$([[ "$svc" == postgres ]] && echo "$PG_PORT" || echo "$REDIS_PORT")"; then
        echo "port in use"
      else
        echo "stopped"
      fi
      ;;
    migrate)
      if migrate_done; then echo "done"; else echo "pending"; fi
      ;;
    systemd-backend|systemd-mt5)
      unit="$(systemd_unit "$alias")"
      if unit_installed "$unit"; then
        local state
        state="$(unit_state "$unit")"
        if [[ "$alias" == "execution" ]] && unit_active "$unit" && ! execution_live_available; then
          echo "running/degraded"
        else
          echo "$state"
        fi
      else
        echo "not installed"
      fi
      ;;
    capability)
      if execution_live_available; then
        echo "available"
      else
        echo "unavailable"
      fi
      ;;
    terminal)
      if is_terminal_running; then
        echo "running (PID $(cat "$STATE_DIR/q_terminal.pid"))"
      else
        echo "stopped"
      fi
      ;;
    research)
      echo "not started"
      ;;
  esac
}

service_label() {
  local alias="$1"
  case "$(service_kind "$alias")" in
    docker) echo "docker:$(compose_service "$alias")" ;;
    migrate) echo "alembic upgrade head" ;;
    systemd-backend) echo "$(backend_unit "$alias")" ;;
    systemd-mt5) echo "$(mt5_unit "$alias")" ;;
    capability) echo "execution capability" ;;
    terminal) echo "q_terminal" ;;
    research) echo "-" ;;
  esac
}

cmd_status() {
  printf "%-20s %-28s %-18s %s\n" "ALIAS" "SERVICE" "STATE" "READINESS"
  echo "--- Live stack ---"
  local live_aliases=(
    postgres redis migrate api outbox
    publisher execution live terminal
  )
  for alias in "${live_aliases[@]}"; do
    printf "%-20s %-28s %-18s %s\n" \
      "$alias" \
      "$(service_label "$alias")" \
      "$(service_state "$alias")" \
      "$(readiness_summary "$alias")"
  done

  echo "--- Shared MT5 ---"
  local shared_aliases=(mt5 gateway edge)
  for alias in "${shared_aliases[@]}"; do
    printf "%-20s %-28s %-18s %s\n" \
      "$alias" \
      "$(service_label "$alias")" \
      "$(service_state "$alias")" \
      "$(readiness_summary "$alias")"
  done

  echo "--- Research stack ($(research_mode) mode) ---"
  local research_aliases=(
    postgres redis migrate api worker relay ui
  )
  for bare in "${research_aliases[@]}"; do
    printf "%-20s %-28s %-18s %s\n" \
      "research:$bare" \
      "$(research_service_label "$bare")" \
      "$(research_service_state "$bare")" \
      "$(research_readiness "$bare")"
  done
}

cmd_logs() {
  local target="${1:-api}"
  local stack="live"
  local svc="$target"
  if [[ "$target" == live:* ]]; then
    stack="live"
    svc="${target#live:}"
  elif [[ "$target" == research:* ]]; then
    stack="research"
    svc="${target#research:}"
  fi

  if [[ "$stack" == "research" ]]; then
    research_logs "$svc"
    return
  fi

  case "$svc" in
    terminal)
      local log="$STATE_DIR/terminal.log"
      [[ -f "$log" ]] || die "log not found: $log"
      dev_follow tail -f "$log"
      ;;
    postgres|redis)
      ensure_docker
      dev_follow "${COMPOSE[@]}" logs -f "$(compose_service "$svc")"
      ;;
    api|outbox|publisher|market|execution|mt5|terminal-mt5|gateway|edge)
      need journalctl
      ensure_systemd_user
      local unit
      unit="$(systemd_unit "$svc")"
      unit_installed "$unit" || die "$unit is not installed (run ./dev live or ./dev up terminal first)"
      dev_follow journalctl --user -u "$unit" -f
      ;;
    *)
      die "logs not available for alias: $target"
      ;;
  esac
}

cmd_restart() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "usage: ./dev restart <service>"
  local stack="live"
  local svc="$target"
  if [[ "$target" == live:* ]]; then
    stack="live"
    svc="${target#live:}"
  elif [[ "$target" == research:* ]]; then
    stack="research"
    svc="${target#research:}"
  fi

  if [[ "$stack" == "research" ]]; then
    research_restart "$svc"
    return
  fi

  case "$svc" in
    terminal)
      stop_terminal
      launch_terminal
      ;;
    postgres|redis)
      ensure_docker
      "${COMPOSE[@]}" restart "$(compose_service "$svc")"
      if [[ "$svc" == postgres ]]; then
        wait_for "postgres" "${COMPOSE[*]} logs postgres" ready_postgres
      else
        wait_for "redis" "${COMPOSE[*]} logs redis" ready_redis
      fi
      ;;
    api|outbox|publisher|market|execution|mt5|terminal-mt5|gateway|edge)
      ensure_systemd_user
      local unit
      unit="$(systemd_unit "$svc")"
      unit_installed "$unit" || die "$unit is not installed"
      systemctl --user restart "$unit"
      case "$svc" in
        api) wait_for "api" "journalctl --user -u $unit -n 30 --no-pager" ready_api ;;
        outbox) wait_for "outbox relay" "journalctl --user -u $unit -n 30 --no-pager" ready_outbox ;;
        publisher|market) wait_for "market-data publisher" "journalctl --user -u $unit -n 30 --no-pager" ready_publisher ;;
        execution) wait_for "execution worker (process)" "journalctl --user -u $unit -n 30 --no-pager" execution_worker_process_ready ;;
        gateway) wait_for "mt5 gateway" "journalctl --user -u $unit -n 30 --no-pager" ready_gateway ;;
        edge) wait_for "mt5 edge" "journalctl --user -u $unit -n 30 --no-pager" ready_edge ;;
      esac
      echo "restarted $unit"
      ;;
    *)
      die "cannot restart alias: $target"
      ;;
  esac
}

dispatch_dev() {
  local cmd="${1:-all}"
  case "$cmd" in
    ""|all)
      cmd_all
      ;;
    live)
      cmd_live
      ;;
    research)
      shift
      cmd_research "$@"
      ;;
    down)
      shift
      cmd_down "${1:-all}"
      ;;
    status)
      cmd_status
      ;;
    logs)
      shift
      cmd_logs "${1:-api}"
      ;;
    restart)
      shift
      cmd_restart "${1:-}"
      ;;
    up)
      shift
      cmd_up "${1:-}"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      die "unknown command: $cmd (try ./dev --help)"
      ;;
  esac
}

# shellcheck source=tools/dev/shell.sh
source "$ROOT/tools/dev/shell.sh"

main() {
  if [[ "${1:-}" == "shell" ]]; then
    cmd_shell
    return 0
  fi
  dispatch_dev "$@"
}

main "$@"
