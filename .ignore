# q/.gitignore hides the sibling repos and .worktrees/ from git. Search tools built on
# ripgrep (Claude Code, Codex) also honour .gitignore, so re-include them here.
# Each repo's own .gitignore still applies inside it.
!/q_backend/
!/q_contracts/
!/q_core/
!/q_frontend/
!/q_terminal/
!/.worktrees/
