#!/usr/bin/env bash
# Compatibility shim for ./dev research
#
# NOTE: Closing the UI or pressing Ctrl+C does not tear down the Research backend.
# Services remain running until explicitly stopped with:
#   ./dev down research (or ./dev down)
#
# Usage:
#   ./research [--host | --container] [--rebuild] [--help]

ROOT="${Q_RESEARCH_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)}"

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  exec "$ROOT/dev" research "$@"
else
  # shellcheck source=tools/dev/research.sh
  source "$ROOT/tools/dev/research.sh"
fi
