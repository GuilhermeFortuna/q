#!/usr/bin/env bash
# Regression harness for ./dev replay (Q-145). Uses fake systemctl, curl, journalctl and q-replay
# on PATH: no real Docker, Wine, MT5, GPU or network is needed.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
PASS=0
FAIL=0
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

ok() { PASS=$((PASS + 1)); echo "ok: $1"; }
bad() { FAIL=$((FAIL + 1)); echo "FAIL: $1" >&2; }

assert_contains() {
  local label="$1" needle="$2" haystack="$3"
  if [[ "$haystack" == *"$needle"* ]]; then ok "$label"; else bad "$label (missing '$needle')"; fi
}
assert_not_contains() {
  local label="$1" needle="$2" haystack="$3"
  if [[ "$haystack" != *"$needle"* ]]; then ok "$label"; else bad "$label (unexpected '$needle')"; fi
}

WS="$TMP/ws"
BIN="$TMP/bin"
LOG="$TMP/calls.log"
STATE="$TMP/state"
DEV_ENV=()
mkdir -p "$WS/tools/dev" "$WS/tools/tests" "$WS/q_backend/.venv/bin" "$WS/q_backend/deploy/systemd/replay" \
  "$BIN" "$STATE/ports" "$TMP/home" "$TMP/dataset" "$TMP/config-dir"
cp "$ROOT/dev" "$WS/dev"
cp "$ROOT/tools/dev/shell.sh" "$ROOT/tools/dev/replay.sh" "$ROOT/tools/dev/research.sh" "$WS/tools/dev/"
cp "$ROOT/tools/tests/test-replay" "$WS/tools/tests/"
# The unit template belongs to the q_backend repository: a workspace checkout provides it, or
# Q_TEST_TEMPLATE points at it (task worktrees keep q_backend outside the meta-repo).
TEMPLATE_SRC="${Q_TEST_TEMPLATE:-$ROOT/q_backend/deploy/systemd/replay/q-replay.service.in}"
[[ -f "$TEMPLATE_SRC" ]] || { echo "FAIL: unit template not found: $TEMPLATE_SRC (set Q_TEST_TEMPLATE)" >&2; exit 1; }
cp "$TEMPLATE_SRC" "$WS/q_backend/deploy/systemd/replay/q-replay.service.in"
cp "$(dirname "$TEMPLATE_SRC")/q-replay-backend.service.in" "$WS/q_backend/deploy/systemd/replay/"
cp "$(dirname "$TEMPLATE_SRC")/compose.yml" "$WS/q_backend/deploy/systemd/replay/"
chmod +x "$WS/dev"
CONFIG="$TMP/config-dir/run.json"
echo '{"symbols":["PETR4"],"account":{"login":145}}' >"$CONFIG"

# Fake systemctl: records the call; `is-active` follows the state file.
cat >"$BIN/systemctl" <<'FAKE'
#!/usr/bin/env bash
echo "systemctl $*" >>"$Q_TEST_CALLS"
case "$*" in
  "--user status") exit 0 ;;
  "--user start q-replay.service"|"--user restart q-replay.service") touch "$Q_TEST_STATE/replay_active" ;;
  "--user stop q-replay-api.service") exit 1 ;;
  "--user stop "*"q-replay.service") rm -f "$Q_TEST_STATE/replay_active" ;;
  "--user is-active --quiet q-replay.service") [[ -f "$Q_TEST_STATE/replay_active" ]] ;;
  "--user is-active --quiet q-replay-"*) [[ -f "$Q_TEST_STATE/consumer_active" ]] ;;
  *) exit 0 ;;
esac
FAKE
# Fake curl: the admin answer depends on whether the simulator "started".
cat >"$BIN/curl" <<'FAKE'
#!/usr/bin/env bash
echo "curl $*" >>"$Q_TEST_CALLS"
if [[ -f "$Q_TEST_STATE/replay_active" ]]; then echo -n 200; else echo -n 000; fi
FAKE
cat >"$BIN/journalctl" <<'FAKE'
#!/usr/bin/env bash
echo "journalctl $*" >>"$Q_TEST_CALLS"
FAKE
cat >"$BIN/docker" <<'FAKE'
#!/usr/bin/env bash
echo "docker $*" >>"$Q_TEST_CALLS"
echo "volume-prefix ${Q_REPLAY_VOLUME_PREFIX:-unset}" >>"$Q_TEST_CALLS"
[[ "$*" == *"ps --status running --services"* ]] && { [[ -f "$Q_TEST_STATE/infra" ]] && printf 'postgres\nredis\n'; exit 0; }
[[ "$*" == *"up -d"* ]] && touch "$Q_TEST_STATE/infra"
[[ "$*" == *"down"* ]] && rm -f "$Q_TEST_STATE/infra"
exit 0
FAKE
for tool in wine python3-mt5 nvidia-smi; do
  cat >"$BIN/$tool" <<FAKE
#!/usr/bin/env bash
echo "FORBIDDEN $tool \$*" >>"\$Q_TEST_CALLS"
exit 99
FAKE
done
# Fake q-replay: `prepare` may be made to fail; the other verbs record their arguments.
cat >"$WS/q_backend/.venv/bin/q-replay" <<'FAKE'
#!/usr/bin/env bash
echo "q-replay $*" >>"$Q_TEST_CALLS"
if [[ "$*" == *"from q_core"* && -f "$Q_TEST_STATE/core_fails" ]]; then exit 1; fi
if [[ "$*" == *"create"* ]]; then echo "q-replay-token ${Q_REPLAY_TOKEN:-unset}" >>"$Q_TEST_CALLS"; fi
if [[ "$*" == *"create"* && -f "$Q_TEST_STATE/create_fails" ]]; then echo "run rejected" >&2; exit 1; fi
if [[ "$1" == "prepare" && -f "$Q_TEST_STATE/prepare_fails" ]]; then
  echo "checksum mismatch" >&2
  exit 2
fi
if [[ "$*" == *"status"* && -f "$Q_TEST_STATE/replaced_generation" ]]; then
  echo '{"generation":"gen-replaced","state":"paused"}'
elif [[ "$*" == *"create"* || "$*" == *"status"* ]]; then echo '{"generation":"gen-test","state":"paused"}'; fi
exit 0
FAKE
for tool in python alembic q-api q-execution q-market-publisher q-outbox-relay; do
  cp "$WS/q_backend/.venv/bin/q-replay" "$WS/q_backend/.venv/bin/$tool"
done
cat >"$WS/q_backend/.venv/bin/alembic" <<FAKE
#!/usr/bin/env bash
printf 'migration %s\\n' "\$*" >>"$LOG"
FAKE
chmod +x "$BIN"/* "$WS/q_backend/.venv/bin/"*

run_dev() {
  : >"$LOG"
  set +e
  OUT="$(env -i PATH="$BIN:/usr/bin:/bin" HOME="$TMP/home" XDG_CONFIG_HOME="$TMP/home/.config" \
    Q_TEST_CALLS="$LOG" Q_TEST_STATE="$STATE" Q_REPLAY_STATE_DIR="$STATE/replay-state" \
    "${DEV_ENV[@]}" Q_REPLAY_BIN="$WS/q_backend/.venv/bin/q-replay" Q_DEV_WAIT_ATTEMPTS=2 Q_DEV_WAIT_INTERVAL=0 \
    bash "$WS/dev" "$@" 2>&1)"
  RC=$?
  set -e
  CALLS="$(cat "$LOG")"
}

reset_state() {
  rm -rf "$STATE/replay_active" "$STATE/prepare_fails" "$STATE/create_fails" "$STATE/ports" "$STATE/infra" "$STATE/replay-state" "$STATE/consumer_active" "$STATE/replaced_generation" "$STATE/core_fails"
  mkdir -p "$STATE/ports"
}

# 1. Launcher syntax and argument validation.
bash -n "$WS/dev" && bash -n "$WS/tools/dev/replay.sh" && ok "launcher and replay module parse" \
  || bad "launcher syntax"

reset_state
run_dev replay
[[ $RC -ne 0 ]] && assert_contains "replay requires --config" "requires --config" "$OUT" || bad "replay without --config should fail"

run_dev replay --config "$TMP/missing.json"
[[ $RC -ne 0 ]] && assert_contains "missing config is refused" "not found" "$OUT" || bad "missing config should fail"

# 2. A failed offline verification stops before anything starts.
reset_state
touch "$STATE/prepare_fails"
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
[[ $RC -ne 0 ]] && assert_contains "verification failure is reported" "failed verification" "$OUT" \
  || bad "verification failure should fail the launch"
assert_not_contains "nothing starts after a failed verification" "systemctl --user start" "$CALLS"

reset_state
touch "$STATE/core_fails"
run_dev replay --config "$CONFIG"
[[ $RC -ne 0 ]] && ok "absent released core capability refused" || bad "missing core accepted"
assert_not_contains "missing core starts no service" "systemctl --user start" "$CALLS"
# 3. A busy replay port is refused before start.
reset_state
touch "$STATE/ports/18913"
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
[[ $RC -ne 0 ]] && assert_contains "busy broker port is refused" "already in use" "$OUT" || bad "busy port should refuse"
assert_not_contains "busy port prevents start" "systemctl --user start" "$CALLS"

# 4. Successful launch: prepared, paused, scoped unit and environment, no forbidden tools.
reset_state
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
[[ $RC -eq 0 ]] && ok "replay launch succeeds" || bad "replay launch failed: $OUT"
assert_contains "the replay unit is started" "systemctl --user start q-replay.service" "$CALLS"
assert_contains "a previously failed simulator is reset before start" "systemctl --user reset-failed q-replay.service" "$CALLS"
assert_contains "database is migrated" "migration -c" "$CALLS"
assert_contains "the run is created through the admin API" "q-replay --url http://127.0.0.1:18914 create" "$CALLS"
assert_contains "output names the external resume" "Resume after deployment setup" "$OUT"
assert_not_contains "no forbidden tool runs" "FORBIDDEN" "$CALLS"
UNIT="$TMP/home/.config/systemd/user/q-replay.service"
if [[ -f "$UNIT" ]] && ! grep -q "__REPLAY" "$UNIT"; then ok "unit is rendered without placeholders"; else bad "unit not rendered"; fi
# systemd ignores a quoted EnvironmentFile path; the simulator then starts without its settings.
if grep -q "^EnvironmentFile=/" "$UNIT"; then ok "unit names its environment file unquoted"; else bad "EnvironmentFile must be an unquoted absolute path"; fi
if grep -q "^WorkingDirectory=/" "$TMP/home/.config/systemd/user/q-replay-api.service"; then ok "unit names its working directory unquoted"; else bad "WorkingDirectory must be an unquoted absolute path"; fi
ENVF="$STATE/replay-state/replay.env"
if [[ -f "$ENVF" ]] && grep -q "Q_REPLAY_ADMIN_PORT=18914" "$ENVF" && grep -q "Q_REPLAY_STORE=" "$ENVF"; then
  ok "run-scoped environment is written"
else
  bad "environment file missing"
fi

# Full stack services and isolation.
for unit in api execution-worker market-publisher outbox-relay terminal; do
  assert_contains "replay starts $unit" "q-replay-$unit.service" "$CALLS"
done
assert_contains "isolated infrastructure" "up -d --wait postgres redis" "$CALLS"
for setting in "Q_DATABASE_URL=postgresql+psycopg://q:q@127.0.0.1:5436/q" "Q_REDIS_URL=redis://127.0.0.1:6382/0" "Q_MARKET_CLOCK_GENERATION=gen-test" "Q_MARKET_DATA_CACHE_NAMESPACE=gen-test" "Q_MT5_GATEWAY_URL=http://127.0.0.1:18912" "Q_MT5_EDGE_URL=http://127.0.0.1:18913" "Q_PORT=8002" "Q_TERMINAL_SYMBOL=PETR4" "Q_TERMINAL_TIMEFRAME=1m"; do
  assert_contains "shared env $setting" "$setting" "$(cat "$STATE/replay-state/backend.env")"
done
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
[[ $RC -eq 0 ]] && ok "repeated start reuses same generation" || bad "repeated start failed: $OUT"
assert_not_contains "repeated start creates no new run" " create " "$CALLS"
assert_not_contains "repeated start writes no generation" "prepare" "$CALLS"

touch "$STATE/replaced_generation"
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
[[ $RC -ne 0 ]] && ok "generation replacement refused" || bad "replaced generation reused"
assert_not_contains "replacement starts no consumers" "systemctl --user start" "$CALLS"
rm "$STATE/replaced_generation"
DEV_ENV=(Q_MT5_GATEWAY_URL=http://127.0.0.1:18812)
run_dev replay --config "$CONFIG"
[[ $RC -ne 0 ]] && ok "mixed live endpoint refused" || bad "mixed endpoint accepted"
DEV_ENV=()
# 5. A foreign running simulator refuses a second run.
reset_state
touch "$STATE/replay_active"
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
[[ $RC -ne 0 ]] && assert_contains "running simulator refuses a new run" "already running" "$OUT" \
  || bad "a running simulator must refuse a new run"
assert_not_contains "no second start while running" "systemctl --user start" "$CALLS"
reset_state
touch "$STATE/consumer_active"
run_dev replay --config "$CONFIG"
[[ $RC -ne 0 ]] && ok "orphaned consumers prevent new generation" || bad "orphaned consumers accepted"

# 5b. A unit that refuses to stop does not keep the simulator running (Q-146 regression).
reset_state
touch "$STATE/replay_active"
run_dev down replay
[[ $RC -eq 0 ]] && ok "down replay succeeds when one unit refuses to stop" || bad "down failed: $OUT"
[[ ! -f "$STATE/replay_active" ]] && ok "the simulator stops even when another unit refuses" \
  || bad "the simulator kept running after down"
assert_contains "down reports the stopped phase" "Replay stack stopped" "$OUT"

# 5c. A run marked as running with no published token is refused with its reason, not a traceback.
reset_state
run_dev replay --config "$CONFIG" --root "$TMP/dataset" --no-terminal
rm -f "$STATE/replay-state/current.json"
run_dev replay --config "$CONFIG" --root "$TMP/dataset" --no-terminal
[[ $RC -ne 0 ]] && assert_contains "unpublished running simulator is refused with its reason" "no run is published" "$OUT" \
  || bad "an unpublished running simulator was accepted"
assert_not_contains "no traceback reaches the operator" "KeyError" "$OUT"
run_dev down replay

# 6. Scoped stop: replay only; live and research are untouched.
reset_state
touch "$STATE/replay_active"
run_dev down replay
assert_contains "down replay stops only the replay unit" "q-replay.service" "$CALLS"

reset_state
touch "$STATE/replay_active"
run_dev down live
assert_not_contains "down live leaves replay running" "q-replay.service" "$CALLS"

reset_state
touch "$STATE/replay_active"
run_dev down all
assert_contains "down all includes replay" "q-replay.service" "$CALLS"

# 7. Restart by alias and the status section.
reset_state
touch "$STATE/replay_active"
run_dev restart replay:simulator
assert_contains "restart replay:simulator restarts the unit" "systemctl --user restart q-replay.service" "$CALLS"

reset_state
touch "$STATE/replay_active"
run_dev status
assert_contains "status lists the replay simulator" "Replay stack (isolated)" "$OUT"

# 8. The replay paths never call Docker, Wine or MT5 tooling (checked on a full stop and restart).
reset_state
touch "$STATE/replay_active"
run_dev down replay
assert_not_contains "replay stop calls no Wine or MT5 tool" "FORBIDDEN" "$CALLS"
run_dev restart replay:simulator
assert_not_contains "replay restart calls no Wine or MT5 tool" "FORBIDDEN" "$CALLS"

reset_state
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
for service in api execution publisher outbox terminal postgres redis simulator; do
  run_dev logs "replay:$service"
  [[ $RC -eq 0 ]] && ok "logs replay:$service" || bad "logs replay:$service: $OUT"
  case "$service" in
    api|terminal) expected="journalctl --user -u q-replay-$service.service" ;;
    execution) expected="journalctl --user -u q-replay-execution-worker.service" ;;
    publisher) expected="journalctl --user -u q-replay-market-publisher.service" ;;
    outbox) expected="journalctl --user -u q-replay-outbox-relay.service" ;;
    simulator) expected="journalctl --user -u q-replay.service" ;;
    postgres|redis) expected="logs -f $service" ;;
  esac
  assert_contains "logs resolves $service correctly" "$expected" "$CALLS"
  run_dev restart "replay:$service"
  [[ $RC -eq 0 ]] && ok "restart replay:$service" || bad "restart replay:$service: $OUT"
done
DEV_ENV=(Q_REPLAY_VOLUME_PREFIX=normal-live-data)
run_dev logs replay:postgres
assert_not_contains "caller cannot replace run volume identity" "volume-prefix normal-live-data" "$CALLS"
assert_contains "stored volume identity used" "volume-prefix q-replay-run-" "$CALLS"
DEV_ENV=()
reset_state
touch "$STATE/ports/8002"
run_dev replay --config "$CONFIG"
[[ $RC -ne 0 ]] && ok "API port collision refused" || bad "API collision accepted"
assert_not_contains "API collision creates no run" " create " "$CALLS"
# A stopped run leaves artifacts; the next run gets fresh storage/cache roots.
reset_state
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
OLD_ENV="$(cat "$STATE/replay-state/backend.env")"
run_dev down replay
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
[[ "$OLD_ENV" != "$(cat "$STATE/replay-state/backend.env")" ]] && ok "next run uses fresh roots" || bad "run roots reused"
assert_not_contains "normal backend env untouched" "/.config/q/backend.env" "$CALLS"
assert_not_contains "normal units untouched" "start q-api.service" "$CALLS"
reset_state
DEV_ENV=(Q_REPLAY_PG_PORT=5434)
touch "$STATE/ports/5434"
run_dev replay --config "$CONFIG"
[[ $RC -ne 0 ]] && ok "live Postgres collision refused" || bad "live Postgres collision accepted"
DEV_ENV=()
printf 'replay --config %s --root %s\nlogs replay:api\ndown replay\nexit\n' "$CONFIG" "$TMP/dataset" >"$TMP/input"
reset_state
run_dev shell <"$TMP/input"
assert_contains "shell starts replay" "q-replay-api.service" "$CALLS"
assert_contains "shell stops replay" "systemctl --user stop q-replay" "$CALLS"
# 9. Replay run state file (Q-146): ready after a launch, idle after shutdown, failed after a failed
# launch, mode 0600, one admin token per run that matches the simulator environment.
STATE_FILE="$STATE/replay-state/current.json"
state_field() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))' "$STATE_FILE" "$1"; }
reset_state
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
[[ "$(state_field phase)" == ready ]] && ok "state file reports ready" || bad "state file phase: $(state_field phase)"
[[ "$(state_field generation)" == gen-test ]] && ok "state file names the generation" || bad "generation missing"
[[ "$(state_field admin_url)" == http://127.0.0.1:18914 ]] && ok "state file names the admin URL" || bad "admin URL missing"
TOKEN_1="$(state_field admin_token)"
[[ -n "$TOKEN_1" ]] && ok "state file carries the per-run admin token" || bad "admin token missing"
[[ "$(stat -c %a "$STATE_FILE")" == 600 ]] && ok "state file is mode 0600" || bad "state file mode $(stat -c %a "$STATE_FILE")"
assert_contains "simulator environment receives the same token" "Q_REPLAY_TOKEN=$TOKEN_1" "$(cat "$ENVF")"
assert_contains "create call carries the run token" "q-replay-token $TOKEN_1" "$CALLS"

run_dev down replay
[[ "$(state_field phase)" == idle ]] && ok "shutdown publishes idle" || bad "shutdown phase: $(state_field phase)"
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
TOKEN_2="$(state_field admin_token)"
[[ -n "$TOKEN_2" && "$TOKEN_2" != "$TOKEN_1" ]] && ok "each run gets a fresh token" || bad "token reused across runs"

run_dev down replay
reset_state
touch "$STATE/create_fails"
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
[[ $RC -ne 0 ]] && assert_contains "failed create reports the launcher reason" "replay run creation failed" "$OUT" \
  || bad "failed create should fail the launch"
[[ "$(state_field phase)" == failed ]] && ok "failed launch publishes failed, not starting" || bad "failed phase: $(state_field phase)"
assert_not_contains "failed launch publishes no token" "admin_token" "$(cat "$STATE_FILE")"

# A refused second start leaves the running stack's state untouched.
reset_state
run_dev replay --config "$CONFIG" --root "$TMP/dataset"
run_dev replay --config "$CONFIG" --root "$TMP/dataset" --no-terminal
[[ "$(state_field phase)" == ready ]] && ok "a reused run stays ready" || bad "reused run phase: $(state_field phase)"

# 10. --no-terminal starts the stack without q_terminal; replay terminal opens it on a running stack.
run_dev down replay
reset_state
run_dev replay --config "$CONFIG" --root "$TMP/dataset" --no-terminal
[[ $RC -eq 0 ]] && ok "no-terminal launch succeeds" || bad "no-terminal launch failed: $OUT"
assert_not_contains "no-terminal starts no terminal unit" "systemctl --user start q-replay-terminal.service" "$CALLS"
assert_contains "no-terminal still starts the API" "systemctl --user start q-replay-api.service" "$CALLS"

run_dev down replay
reset_state
run_dev replay terminal
[[ $RC -ne 0 ]] && assert_contains "terminal refused without a running stack" "not running" "$OUT" \
  || bad "terminal opened without a running stack"
reset_state
run_dev replay --config "$CONFIG" --root "$TMP/dataset" --no-terminal
run_dev replay terminal
[[ $RC -eq 0 ]] && assert_contains "replay terminal starts the terminal unit" "systemctl --user start q-replay-terminal.service" "$CALLS" \
  || bad "replay terminal failed: $OUT"
run_dev replay terminal extra
[[ $RC -ne 0 ]] && ok "replay terminal takes no options" || bad "replay terminal accepted an option"
run_dev down replay

# 11. Host-mode Research exports the replay run manager settings (container mode never calls this).
EXPORTS="$(env -i PATH="/usr/bin:/bin" bash -c '
  set -e
  ROOT="'"$WS"'"; STATE_DIR="'"$STATE"'/dev-state"
  source "'"$WS"'/tools/dev/research.sh"
  export_host_backend_env
  printf "%s|%s|%s" "$Q_REPLAY_CONTROL_ENABLED" "$Q_REPLAY_LAUNCHER" "$Q_REPLAY_STATE_DIR"' 2>&1)"
assert_contains "host research enables replay control" "1|$WS/dev|$STATE/dev-state/replay" "$EXPORTS"

echo "passed: $PASS failed: $FAIL"
[[ $FAIL -eq 0 ]]
