  ws="$(mktemp -d)"
  setup_workspace "$ws"
  mkdir -p "$ws/q_backend/data/lake" "$ws/state/images"
  echo "FINGERPRINT=keep" >"$ws/state/images/q-backend:dev"
  echo "precious" >"$ws/q_backend/data/lake/x.parquet"
  (
    export Q_TEST_STATE="$ws/state" Q_RESEARCH_ROOT="$ws" PATH="$(test_path "$ws")"
    # shellcheck disable=SC1091
    source "$ws/research"
    CLEANED_UP=0
    UI_PID=""
