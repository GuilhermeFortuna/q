    : >"$ws/state/docker.log"
    run_research "$ws" --container >/dev/null 2>&1 || true
    assert_eq "stale $input rebuilds once" "1" "$(count_log "$ws/state/docker.log" '^docker build ')"
    rm -rf "$ws"
  done
}

