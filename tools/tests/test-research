test_gpu_preflight_fails_before_compose_up() {
  local ws out builds ups
  # missing nvidia-smi
  ws="$(mktemp -d)"
  setup_workspace "$ws"
  rm -f "$ws/bin/nvidia-smi"
  out="$(run_research "$ws" --container 2>&1 || true)"
  assert_contains "names nvidia-smi missing" "nvidia-smi" "$out"
  assert_eq "no compose up when nvidia-smi missing" "0" "$(count_log "$ws/state/docker.log" 'compose .*\bup\b')"
  rm -rf "$ws"

  # nvidia-smi fails
  ws="$(mktemp -d)"
  setup_workspace "$ws"
  out="$(
    cd "$ws"
    export Q_TEST_STATE="$ws/state" Q_RESEARCH_ROOT="$ws" PATH="$(test_path "$ws")" Q_FAKE_NVIDIA_SMI_FAIL=1
    timeout 10 "$ws/research" --container 2>&1 || true
  )"
  assert_contains "host GPU failure mentions nvidia-smi" "nvidia-smi" "$out"
  assert_eq "no compose up when host GPU fails" "0" "$(count_log "$ws/state/docker.log" 'compose .*\bup\b')"
  rm -rf "$ws"

  # missing nvidia-ctk
  ws="$(mktemp -d)"
  setup_workspace "$ws"
  rm -f "$ws/bin/nvidia-ctk"
  out="$(run_research "$ws" --container 2>&1 || true)"
  assert_contains "names nvidia-ctk missing" "nvidia-ctk" "$out"
  assert_eq "no compose up when nvidia-ctk missing" "0" "$(count_log "$ws/state/docker.log" 'compose .*\bup\b')"
  rm -rf "$ws"

  # CUDA probe fails after image exists
  ws="$(mktemp -d)"
  setup_workspace "$ws"
  (
    export Q_TEST_STATE="$ws/state" Q_RESEARCH_ROOT="$ws" PATH="$(test_path "$ws")"
    # shellcheck disable=SC1091
    source "$ws/research"
    fp="$(image_fingerprint)"
    mkdir -p "$ws/state/images"
    echo "FINGERPRINT=$fp" >"$ws/state/images/q-backend:dev"
  )
  out="$(
    cd "$ws"
    export Q_TEST_STATE="$ws/state" Q_RESEARCH_ROOT="$ws" PATH="$(test_path "$ws")" Q_FAKE_CUDA_PROBE_FAIL=1
    timeout 10 "$ws/research" --container 2>&1 || true
  )"
  assert_contains "CUDA probe failure is actionable" "CUDA" "$out"
  assert_eq "no compose up when CUDA probe fails" "0" "$(count_log "$ws/state/docker.log" 'compose .*\bup\b')"
  rm -rf "$ws"
}

