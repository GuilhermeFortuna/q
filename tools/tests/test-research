  assert_not_contains "cleanup has no prune" "prune" "$(cat "$ws/state/docker.log" 2>/dev/null || true)"
  assert_not_contains "cleanup has no -v" " --volumes" "$(cat "$ws/state/docker.log" 2>/dev/null || true)"
  assert_eq "data preserved" "precious" "$(cat "$ws/q_backend/data/lake/x.parquet")"
  rm -rf "$ws"
}

