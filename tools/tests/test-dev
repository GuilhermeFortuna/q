test_research_dispatch_and_rebuild() {
  local ws out
  ws="$(mktemp -d)"
  setup_workspace "$ws"
  # Default research is host mode
  out="$(run_dev "$ws" research 2>&1 || true)"
  assert_contains "research starts research UI" "launching Research UI" "$out"
  assert_contains "research default mode is host" "mode:  host" "$out"

  # --rebuild without container mode fails
  out="$(run_dev "$ws" research --rebuild 2>&1 || true)"
  assert_contains "rebuild requires container mode" "--rebuild requires container mode" "$out"

  # Stop research before starting in container mode
  run_dev "$ws" down research >/dev/null 2>&1 || true

  # --container selects container mode
  out="$(run_dev "$ws" research --container 2>&1 || true)"
  assert_contains "container mode is selected" "mode:  container" "$out"

  clean_workspace "$ws"
}

test_repeated_start_is_idempotent() {
  local ws out1 out2
  ws="$(mktemp -d)"
  setup_workspace "$ws"
  out1="$(run_dev "$ws" all 2>&1 || true)"
  out2="$(run_dev "$ws" all 2>&1 || true)"
  assert_contains "repeated start detects q_terminal running" "q_terminal: already running" "$out2"
  assert_contains "repeated start detects Research UI running" "Research UI: already running" "$out2"
  clean_workspace "$ws"
}

test_selective_down() {
  local ws out_live out_res out_all
  ws="$(mktemp -d)"
  setup_workspace "$ws"

  # Start all first
  run_dev "$ws" all >/dev/null 2>&1 || true

  # Stop only live
  out_live="$(run_dev "$ws" down live 2>&1 || true)"
  assert_contains "down live stops live stack" "Q live dev stack stopped" "$out_live"
  assert_not_contains "down live does not stop research" "Research stack stopped" "$out_live"

  # Stop research
  out_res="$(run_dev "$ws" down research 2>&1 || true)"
  assert_contains "down research stops research stack" "Research stack stopped" "$out_res"

  # Restart all, then down all
  run_dev "$ws" all >/dev/null 2>&1 || true
  out_all="$(run_dev "$ws" down 2>&1 || true)"
  assert_contains "bare down stops all stacks" "All Q dev stacks stopped" "$out_all"

  clean_workspace "$ws"
}

test_shared_gateway_retention() {
  local ws out
  ws="$(mktemp -d)"
  setup_workspace "$ws"
  touch "$ws/home/.config/systemd/user/mt5-gateway.service"

  # Start both stacks
  run_dev "$ws" all >/dev/null 2>&1 || true

  # With research running and using local gateway, down live should retain gateway
  out="$(run_dev "$ws" down live 2>&1 || true)"
  assert_contains "down live retains shared gateway" "Keeping shared MT5 terminal and gateway running" "$out"

  # down research never stops MT5 gateway
  run_dev "$ws" all >/dev/null 2>&1 || true
  out="$(run_dev "$ws" down research 2>&1 || true)"
  assert_not_contains "down research does not stop shared gateway" "mt5-gateway.service" "$out"

  # down all stops shared gateway
  out="$(run_dev "$ws" down all 2>&1 || true)"
  assert_not_contains "down all does not retain gateway" "Keeping shared MT5 terminal" "$out"
  assert_contains "down all stops all" "All Q dev stacks stopped" "$out"

  clean_workspace "$ws"
}

test_gateway_retention_uses_research_startup_state() {
  local ws out
  ws="$(mktemp -d)"
  setup_workspace "$ws"
  touch "$ws/home/.config/systemd/user/mt5-gateway.service"

  run_dev "$ws" all >/dev/null 2>&1 || true
  out="$(Q_RESEARCH_MT5=off run_dev "$ws" down live 2>&1 || true)"
  assert_contains "later off setting cannot stop Research's local gateway" \
    "Keeping shared MT5 terminal and gateway running" "$out"
  clean_workspace "$ws"

  ws="$(mktemp -d)"
  setup_workspace "$ws"
  touch "$ws/home/.config/systemd/user/mt5-gateway.service"
  Q_RESEARCH_MT5=off run_dev "$ws" all >/dev/null 2>&1 || true
  out="$(run_dev "$ws" down live 2>&1 || true)"
  assert_not_contains "later default cannot invent Research gateway use" \
    "Keeping shared MT5 terminal and gateway running" "$out"
  clean_workspace "$ws"
}

