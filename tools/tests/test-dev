test_terminal_launch_paths_and_pidfile_reuse() {
  local ws last_env out lines_count

  ws="$(mktemp -d)"
  setup_workspace "$ws"

  # 1. Default / all dispatch
  (
    unset Q_TERMINAL_SYMBOL Q_TERMINAL_TIMEFRAME
    run_dev "$ws" all >/dev/null 2>&1 || true
  )
  wait_for_file_lines "$ws/state/terminal_env.log" 1
  last_env="$(tail -n 1 "$ws/state/terminal_env.log" 2>/dev/null || true)"
  assert_eq "all dispatch launches terminal with common absent target" \
    "sym=<absent> tf=<absent> api=http://127.0.0.1:8000" "$last_env"

  # 2. Pidfile reuse: running all again should NOT launch make again
  out="$(run_dev "$ws" all 2>&1 || true)"
  assert_contains "repeated all reports terminal already running" "q_terminal: already running" "$out"
  lines_count="$(wc -l <"$ws/state/terminal_env.log" 2>/dev/null || echo 0)"
  assert_eq "already running terminal does not invoke make again" "1" "$lines_count"

  # 3. Clean and test legacy up terminal
  run_dev "$ws" down all >/dev/null 2>&1 || true
  rm -f "$ws/state/terminal_env.log"
  (
    export Q_TERMINAL_SYMBOL="PETR4"
    unset Q_TERMINAL_TIMEFRAME
    run_dev "$ws" up terminal >/dev/null 2>&1 || true
  )
  wait_for_file_lines "$ws/state/terminal_env.log" 1
  last_env="$(tail -n 1 "$ws/state/terminal_env.log" 2>/dev/null || true)"
  assert_eq "up terminal dispatch respects target environment" \
    "sym=PETR4 tf=<absent> api=http://127.0.0.1:8000" "$last_env"

  # 4. Clean and test legacy up full
  run_dev "$ws" down all >/dev/null 2>&1 || true
  rm -f "$ws/state/terminal_env.log"
  (
    unset Q_TERMINAL_SYMBOL
    export Q_TERMINAL_TIMEFRAME="5m"
    run_dev "$ws" up full >/dev/null 2>&1 || true
  )
  wait_for_file_lines "$ws/state/terminal_env.log" 1
  last_env="$(tail -n 1 "$ws/state/terminal_env.log" 2>/dev/null || true)"
  assert_eq "up full dispatch respects target environment" \
    "sym=<absent> tf=5m api=http://127.0.0.1:8000" "$last_env"

  # 5. Clean and test interactive shell dispatch
  run_dev "$ws" down all >/dev/null 2>&1 || true
  rm -f "$ws/state/terminal_env.log"
  (
    export Q_TERMINAL_SYMBOL="MGLU3"
    export Q_TERMINAL_TIMEFRAME="15m"
    run_dev_shell "$ws" $'up live\nexit\n' >/dev/null 2>&1 || true
  )
  wait_for_file_lines "$ws/state/terminal_env.log" 1
  last_env="$(tail -n 1 "$ws/state/terminal_env.log" 2>/dev/null || true)"
  assert_eq "shell up live dispatch shares common launch handler" \
    "sym=MGLU3 tf=15m api=http://127.0.0.1:8000" "$last_env"

  clean_workspace "$ws"
}

test_launcher_does_not_read_workspace_files() {
  local ws out refs
  ws="$(mktemp -d)"
  setup_workspace "$ws"

  # Create terminal workspace structure with unreadable permissions
  mkdir -p "$ws/home/.config/q_terminal/workspaces"
  cat >"$ws/home/.config/q_terminal/workspaces/Trading.toml" <<'EOF'
schema_version = 3
name = "Trading"
[chart_preferences.chart]
symbol = "SAVED_SYM"
timeframe = "15m"
EOF
  cat >"$ws/home/.config/q_terminal/state.toml" <<'EOF'
last_workspace = "Trading"
EOF
  # Make the q_terminal configuration directory completely unreadable to prove
  # launcher never touches or reads workspace files directly.
  chmod 000 "$ws/home/.config/q_terminal"

  out="$(run_dev "$ws" live 2>&1 || true)"
  assert_contains "launcher succeeds without touching q_terminal workspace files" "q_terminal started" "$out"

  # Restore permissions for cleanup
  chmod 755 "$ws/home/.config/q_terminal"
  clean_workspace "$ws"

  # Also assert that launcher source scripts contain no q_terminal workspace references
  refs="$(grep -E 'q_terminal/workspaces|\.config/q_terminal|workspaces/.*\.toml' "$ROOT/dev" "$ROOT/tools/dev/"* 2>/dev/null || true)"
  assert_eq "no workspace file references in launcher scripts" "" "$refs"
}

