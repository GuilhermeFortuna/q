test_terminal_target_unset() {
  local ws last_env
  ws="$(mktemp -d)"
  setup_workspace "$ws"
  (
    unset Q_TERMINAL_SYMBOL Q_TERMINAL_TIMEFRAME
    run_dev "$ws" live >/dev/null 2>&1 || true
  )
  wait_for_file_lines "$ws/state/terminal_env.log" 1
