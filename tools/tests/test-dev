  assert_contains "default starts both stacks" "Both Live and Research stacks started" "$out"
  assert_contains "default launches q_terminal" "q_terminal started" "$out"
  assert_contains "default launches Research UI" "launching Research UI" "$out"
  clean_workspace "$ws"
}

